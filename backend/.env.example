# Copy to .env and adjust. All values have sensible defaults.

APP_NAME=HaqFlow Backend
ENVIRONMENT=development

# Default: local SQLite (zero setup). For the shared team DB use Supabase/Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./haqflow.db

AUTO_CREATE_TABLES=true
AUTO_SEED_PROGRAMS=true

# Frontend origins (comma-separated JSON list). "*" allows all during the hackathon.
# CORS_ORIGINS=["http://localhost:3000"]
